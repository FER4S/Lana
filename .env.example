# ─────────────────────────────────────────────
#  .env.example – Template for required secrets
#
#  Copy this file to `.env` and fill in real values.
#  The `.env` file must NEVER be committed to git.
# ─────────────────────────────────────────────

# ── Claude API ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use (default: claude-opus-4-5)
# CLAUDE_MODEL=claude-opus-4-5

# ── Wake Word ─────────────────────────────────
# openwakeword model: custom .onnx path or built-in name.
# Default: the custom "Hey Lana" model at models/hey_lana.onnx.
# Rollback to the pretrained phrase: WAKE_WORD_MODEL=hey_jarvis
# WAKE_WORD_MODEL=
# WAKE_WORD_THRESHOLD=0.5
# Threshold for barge-in (interrupting Lana mid-reply by saying the wake word).
# On speakers her own voice can bleed into the mic; raise this (e.g. 0.75) if she
# self-interrupts, until it stops while a deliberate close "Hey Lana" still fires.
# BARGE_IN_THRESHOLD=0.6

# ── Microphone ────────────────────────────────
# Leave blank to use the system default microphone
# MIC_DEVICE_INDEX=
# MIC_SAMPLE_RATE=16000
# MIC_CHANNELS=1

# ── faster-whisper STT ────────────────────────
# Model size: tiny | base | small | medium | large-v2 | large-v3 | large-v3-turbo
# WHISPER_MODEL_SIZE=large-v3-turbo
# Device: cuda (GPU) or cpu
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
# Smaller model used automatically if CUDA fails and STT falls back to CPU
# WHISPER_CPU_FALLBACK_MODEL=base
# WHISPER_LANGUAGE=en

# ── Text-to-Speech (Kokoro-82M) ───────────────
# Voice ID (default: af_bella; e.g. am_michael, af_heart, bf_emma)
# TTS_VOICE=af_bella
# TTS_SPEED=1.1
# Device: auto (default) | cuda | cpu. Set cpu if loading Kokoro on the GPU
# crashes the process (a native torch/CUDA crash the CPU fallback can't catch).
# Whisper stays on WHISPER_DEVICE, so STT can remain on the GPU independently.
# TTS_DEVICE=cpu

# ── Hosted voice providers ────────────────────
# Used when speech runs off-device: no GPU on the server, microphone in a
# browser tab. The two settings above (Whisper / Kokoro) apply only to the
# local-GPU path and are ignored once these are in use.
# Provider names are resolved the same way email picks a fetcher/sender, so a
# vendor swap is a config change, not a code change.
# "local" = the GPU pipeline this project shipped with (faster-whisper, Kokoro,
# openWakeWord, microphone on this machine). Anything else routes to a hosted
# provider with the microphone in a browser tab.
#
# Both DEFAULT to "local" while the browser audio transport is being built.
# The Linux server MUST set them explicitly — it has no GPU and no microphone,
# and the local engines will not even import there.
# STT_PROVIDER=local        # local | deepgram
# TTS_PROVIDER=local        # local | cartesia | elevenlabs

# ── Speech-to-text: Deepgram ──
# Create a key at https://console.deepgram.com (new accounts get $200 of credit,
# roughly 45,000 minutes, with no card — enough to build and test against).
DEEPGRAM_API_KEY=
# flux-general-en decides end-of-turn with a real model (~260 ms) rather than a
# fixed silence timer. This replaces the local RMS endpointing, which was
# calibrated to raw int16 from one microphone and does not survive browser
# capture (browsers apply AGC and noise suppression and deliver float32).
# DEEPGRAM_MODEL=flux-general-en
# Model for batch / non-conversational transcription.
# DEEPGRAM_BATCH_MODEL=nova-3
# BCP-47 language tag. Arabic is the reason this vendor was chosen: "ar" plus
# regional variants (ar-EG, ar-SA, ar-AE, ...) are first-class models here.
# DEEPGRAM_LANGUAGE=en

# ── Text-to-speech: Cartesia (v1 default) ──
# Create a key at https://play.cartesia.ai/keys.
# Chosen over ElevenLabs for v1 because v1 is English-only (Arabic is its own
# later pass), so ElevenLabs' Arabic advantage does not pay off yet, while
# Cartesia is cheaper and lower-latency. Swapping back is a TTS_PROVIDER change.
CARTESIA_API_KEY=
# CARTESIA_MODEL=sonic-3
# Voice ID from https://play.cartesia.ai/voices.
CARTESIA_VOICE_ID=
# Cartesia pins its API by date and REQUIRES this header on every request;
# omitting it is an error, not a default-to-latest.
# CARTESIA_VERSION=2026-03-01

# ── Text-to-speech: ElevenLabs (kept wired for the Arabic pass) ──
# Create a key at https://elevenlabs.io/app/settings/api-keys.
# Two failure modes worth knowing, both seen on this project:
#   - a permission-scoped key 401s with "missing_permissions"
#   - an account-level "detected_unusual_activity" flag disables free-tier
#     synthesis entirely, and regenerating keys does not clear it
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID=

# ── Shared TTS output contract ──
# Always raw PCM s16le mono, never MP3: browser playback must be able to drop
# queued audio instantly on barge-in, and a decode step would block that.
# TTS_SAMPLE_RATE=24000

# ── Credential store encryption ───────────────
# data/email_accounts.dat (IMAP passwords, Gmail refresh tokens) is encrypted
# at rest. The cipher is chosen by platform and normally needs no configuration:
#   Windows -> DPAPI, bound to this user+machine, NO key file exists
#   Linux   -> Fernet, which needs a key (DPAPI has no Linux equivalent)
#
# On the server, supply the key here rather than letting one be generated:
# a generated key lands in data/account_key, i.e. on the same disk as the
# ciphertext it protects. systemd's LoadCredential= can inject this instead.
#   Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LOSING THIS KEY MEANS RE-ADDING EVERY EMAIL ACCOUNT. Back it up.
# LANA_ACCOUNT_KEY=
#
# Force a cipher. Mainly for exercising the Linux path on Windows, so its
# first real run is not on the server. Values: dpapi | fernet
# LANA_ACCOUNT_CIPHER=

# ── FastAPI Server ────────────────────────────
# Shared secret for the API — the frontend must send it on /start, /stop and
# every /email/* and /plans/* endpoint (Authorization: Bearer <token>), and on
# /events (?token=<token>, since browsers can't set headers on a WS handshake).
# The Gmail OAuth callback is the one exception: a one-time state nonce minted
# by the token-protected /oauth-url endpoint protects that instead.
# Required: with it unset, those endpoints reject every request.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
LANA_API_TOKEN=
# Print a one-click /ui/ link with the token embedded in it at startup.
# Default false. Leave it false on any shared or deployed machine: startup logs
# go to LOG_FILE (10 MB rotation, 7-day zipped retention) and to journald under
# systemd, so switching this on writes the API token to disk in plaintext.
# Only set it true on a personal machine where the .env already holds the token.
# LANA_LOG_TOKEN_LINK=false
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000
# SERVER_RELOAD=false

# ── Logging ───────────────────────────────────
# LOG_LEVEL=INFO
# LOG_FILE=logs/lana.log

# ── Email ─────────────────────────────────────
# Google Cloud OAuth "Web application" client with the Gmail API enabled.
# Register redirect URI: <GOOGLE_OAUTH_REDIRECT_BASE>/email/accounts/gmail/oauth-callback
# (default: http://localhost:8000/email/accounts/gmail/oauth-callback)
# Required for connecting Gmail accounts; IMAP-only accounts work without these.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_BASE=http://localhost:8000
# How often (seconds) to poll connected email accounts for new mail.
# EMAIL_POLL_INTERVAL_S=240
