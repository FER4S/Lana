# ─────────────────────────────────────────────
#  Lana – Voice AI Assistant
#  .gitignore
# ─────────────────────────────────────────────

# Secrets — never commit
.env
# Backups/variants of .env hold the same live keys. Bare ".env" does not match
# ".env.bak.20260805-131808" or ".env.local", so they would sit stageable in the
# repo root and land in a commit via `git add -A`. ".env.example" is the one
# variant that must stay tracked — it carries names and comments, never values.
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Logs
logs/
*.log

# faster-whisper model cache
models/whisper/

# openwakeword model cache
models/openwakeword/

# Lana persistent memory store (local, per-machine, personal data)
# Note: profile.json (the static boss-profile seed) lives at the repo root,
# outside data/, and is deliberately NOT ignored — it's committed.
data/

# Local throwaway verification / scratch scripts
scratchpad/

# Local development tooling / assistant artifacts — keep local, never publish
CLAUDE.md
.claude/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
