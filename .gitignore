# ─────────────────────────────────────────────
#  Lana – Voice AI Assistant
#  .gitignore
# ─────────────────────────────────────────────

# Secrets — never commit
.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Logs
logs/
*.log

# faster-whisper model cache
models/whisper/

# openwakeword model cache
models/openwakeword/

# Lana persistent memory store (local, per-machine, personal data)
# Note: profile.json (the static boss-profile seed) lives at the repo root,
# outside data/, and is deliberately NOT ignored — it's committed.
data/

# Local throwaway verification / scratch scripts
scratchpad/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
